      "options": {
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "historian-timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  tag_id,\n  ROUND(avg(avg_value)::numeric, 3) AS avg_value,\n  min(min_value) AS min_value,\n  max(max_value) AS max_value,\n  sum(sample_count) AS total_samples\nFROM tag_sample_1m\nWHERE\n  $__timeFilter(bucket)\nGROUP BY tag_id\nORDER BY tag_id ASC;",
          "refId": "A"
        }
      ]
    }
