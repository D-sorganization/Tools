      "datasource": {
        "type": "postgres",
        "uid": "historian-timescale"
      },
      "description": "ISA-18.2 §4.3 metric: alarm_rate_10min (target <= 1 per 10 min normal, <= 10 upset)",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "gradientMode": "none",
            "lineWidth": 1
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "historian-timescale"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  time_bucket('10 minutes', timestamp) AS time,\n  count(*) AS alarm_rate_10min\nFROM event_log\nWHERE event_type = 'ALARM' AND severity > 0 AND $__timeFilter(timestamp)\nGROUP BY 1\nORDER BY 1 ASC;",
          "refId": "A"
        }
      ],
      "title": "Average & Peak Alarm Rate (per 10 min)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "custom": {
        "kpi_key": "flood_episodes"
      },
      "datasource": {
        "type": "postgres",
        "uid": "historian-timescale"
      },
      "description": "ISA-18.2 flood threshold: flood_episodes (>10 alarms in 10-minute window)",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "historian-timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH buckets AS (\n  SELECT time_bucket('10 minutes', timestamp) AS b, count(*) AS cnt\n  FROM event_log\n  WHERE event_type = 'ALARM' AND severity > 0 AND $__timeFilter(timestamp)\n  GROUP BY 1\n)\nSELECT count(*) AS flood_episodes FROM buckets WHERE cnt > 10;",
          "refId": "A"
        }
      ],
      "title": "Alarm Flood Episodes (>10 alarms / 10 min)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "custom": {
        "kpi_key": "chattering_alarms"
      },
      "datasource": {
        "type": "postgres",
        "uid": "historian-timescale"
      },
      "description": "ISA-18.2 chattering metric: chattering_alarms (>3 state transitions in 60s)",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 4
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "historian-timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT tag_name) AS chattering_alarms\nFROM (\n  SELECT tag_name, count(*) OVER (\n    PARTITION BY tag_name ORDER BY timestamp RANGE BETWEEN INTERVAL '1 minute' PRECEDING AND CURRENT ROW\n  ) AS win_count\n  FROM event_log\n  WHERE $__timeFilter(timestamp)\n) sub\nWHERE win_count > 3;",
          "refId": "A"
        }
      ],
      "title": "Chattering Alarms (>3/min)",
      "type": "stat"
    },
    {
