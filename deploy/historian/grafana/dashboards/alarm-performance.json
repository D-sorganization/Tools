          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS stale_alarms\nFROM active_alarms\nWHERE timestamp <= NOW() - INTERVAL '24 hours';",
          "refId": "A"
        }
      ],
      "title": "Stale / Standing Alarms (>24h)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "custom": {
        "kpi_key": "top_contributors"
      },
      "datasource": {
        "type": "postgres",
        "uid": "historian-timescale"
      },
      "description": "ISA-18.2 top contributors ranking: top_contributors (target < 5% per tag)",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 5,
      "options": {
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "historian-timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  tag_name AS tag,\n  count(*) AS count,\n  ROUND(count(*) * 100.0 / SUM(count(*)) OVER (), 2) AS percentage\nFROM event_log\nWHERE event_type = 'ALARM' AND severity > 0 AND $__timeFilter(timestamp)\nGROUP BY tag_name\nORDER BY count DESC\nLIMIT 10;",
          "refId": "A"
        }
      ],
      "title": "Top 10 Alarm Contributors",
      "type": "table"
    },
    {
