      },
      "datasource": {
        "type": "postgres",
        "uid": "historian-timescale"
      },
      "description": "ISA-18.2 priority distribution: priority_distribution (Warning ~80%, Trip ~5-15%)",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 6,
      "options": {
        "displayLabels": ["percent", "value"],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": ["percent", "value"]
        },
        "pieType": "pie",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "historian-timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  CASE severity WHEN 1 THEN 'Warning' WHEN 2 THEN 'Trip' ELSE 'Other' END AS priority,\n  count(*) AS count\nFROM event_log\nWHERE event_type = 'ALARM' AND severity > 0 AND $__timeFilter(timestamp)\nGROUP BY severity\nORDER BY severity ASC;",
          "refId": "A"
        }
      ],
      "title": "Alarm Priority Distribution",
      "type": "piechart"
    }
