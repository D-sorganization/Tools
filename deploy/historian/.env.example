# Level 3 Plant Historian Environment Configuration (H8 / #5547)
# Copy this file to .env and configure strong credentials prior to starting containers.
# Do not commit real credentials or production .env files to source control.

# --- TimescaleDB Configuration ---
HISTORIAN_HOST=127.0.0.1
HISTORIAN_PORT=5432
HISTORIAN_DB=historian
HISTORIAN_USER=historian_writer
HISTORIAN_PASSWORD=replace_with_secure_password
HISTORIAN_SSLMODE=disable

# --- Grafana Configuration ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_secure_password
