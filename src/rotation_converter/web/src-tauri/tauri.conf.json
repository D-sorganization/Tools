{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rotation Converter",
  "version": "1.0.0",
  "identifier": "com.tools.rotation-converter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5192",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Rotation Converter",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
