[run]
# Source tree to measure coverage for
source = src
branch = true
parallel = true

# Files/directories to exclude from coverage measurement
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */node_modules/*
    */venv/*
    */.venv/*
    */site-packages/*
    setup.py
    conftest.py
    # Legacy/experimental directories excluded from coverage by policy
    src/data_processing/*
    src/document_processing/*
    src/pendulum_simulator/*
    src/scientific_modeling/*
    src/tools/folder_tools/*
    src/tools/code_quality_check.py

[report]
# Coverage thresholds and reporting
precision = 2
show_missing = true
skip_covered = false
skip_empty = true

# Lines to exclude from coverage measurement
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    raise NotImplementedError
    pass
    if 0:
    if False:
    raise AssertionError
    raise NotImplementedError
    if sys.version_info
    if hasattr(sys, 'frozen')
    @abstractmethod
    @abc.abstractmethod
    raise NotImplementedError
    # Don't complain about script files with if __name__ == __main__
    if type\(self\) is not type\(obj\):

# Minimum coverage threshold for PR gate (can be overridden by policy)
fail_under = 25

[html]
directory = htmlcov
title = Coverage Report
show_contexts = true

[xml]
output = coverage.xml

[json]
output = coverage.json
