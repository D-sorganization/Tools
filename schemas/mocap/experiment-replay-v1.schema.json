{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.d-sorganization.org/mocap/experiment-replay-v1.schema.json",
  "title": "Experiment Replay Bundle v1",
  "description": "Versioned engine-neutral initial-state and time-indexed input identity. The bundle describes replay inputs and provenance; it does not certify physical qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "schema_version",
    "model",
    "capabilities",
    "initial_state",
    "input_history",
    "policy",
    "integrity"
  ],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "experiment-replay/1.0.0"},
    "model": {"$ref": "#/$defs/modelIdentity"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    },
    "initial_state": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/initialStateValue"}
    },
    "input_history": {"$ref": "#/$defs/inputHistory"},
    "policy": {"$ref": "#/$defs/executionPolicy"},
    "integrity": {"$ref": "#/$defs/integrityHashes"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "required", "support", "availability", "reason"],
      "properties": {
        "capability_id": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "support": {"enum": ["supported", "unsupported", "unknown"]},
        "availability": {"enum": ["available", "unavailable", "unknown"]},
        "reason": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "stateComponentSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "role", "dimension", "unit", "representation"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["position", "velocity", "muscle_activation", "muscle_fiber_state", "muscle_tendon_state", "actuator_internal_state", "auxiliary"]},
        "dimension": {"type": "integer", "minimum": 1},
        "unit": {"type": "string", "minLength": 1},
        "representation": {"type": "string", "minLength": 1}
      }
    },
    "stateSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "version", "components"],
      "properties": {
        "schema_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
        "components": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/stateComponentSpec"}
        }
      }
    },
    "modelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_id", "model_id", "variant_id", "model_version", "source_model_sha256", "provider_id", "provider_version", "provider_sha256", "loaded_native_model_sha256", "state_schema", "ordered_input_channel_ids"],
      "properties": {
        "engine_id": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "variant_id": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
        "source_model_sha256": {"$ref": "#/$defs/sha256"},
        "provider_id": {"type": "string", "minLength": 1},
        "provider_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
        "provider_sha256": {"$ref": "#/$defs/sha256"},
        "loaded_native_model_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "state_schema": {"$ref": "#/$defs/stateSchema"},
        "ordered_input_channel_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "initialStateValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "values"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "values": {"type": "array", "minItems": 1, "items": {"type": "number"}}
      }
    },
    "inputChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_id", "target_id", "unit", "coordinate_id", "frame_id"],
      "properties": {
        "channel_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "coordinate_id": {"type": ["string", "null"], "minLength": 1},
        "frame_id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "inputHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_kind", "timebase_id", "interpolation", "time_seconds", "channels", "values"],
      "properties": {
        "input_kind": {"enum": ["actuator_command", "actuator_torque", "actuator_force", "generalized_effort", "muscle_excitation", "muscle_activation", "external_load"]},
        "timebase_id": {"const": "simulation_relative"},
        "interpolation": {"enum": ["zero_order_hold", "linear"]},
        "time_seconds": {"type": "array", "minItems": 2, "items": {"type": "number", "minimum": 0}},
        "channels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inputChannel"}},
        "values": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "array", "minItems": 1, "items": {"type": "number"}}
        }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replay_mode", "solver_id", "solver_version", "integration_method", "step_policy", "step_size_seconds", "initialization_policy_id", "initialization_policy_version", "input_player_id", "input_player_version", "observation_access", "state_feedback_access", "state_reset_allowed", "contact_policy_id", "contact_policy_version", "contact_policy_sha256", "external_loads_sha256"],
      "properties": {
        "replay_mode": {"enum": ["native_own_contact", "externally_forced", "shared_rigid_body_emulation"]},
        "solver_id": {"type": "string", "minLength": 1},
        "solver_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
        "integration_method": {"type": "string", "minLength": 1},
        "step_policy": {"enum": ["fixed", "adaptive"]},
        "step_size_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "initialization_policy_id": {"type": "string", "minLength": 1},
        "initialization_policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
        "input_player_id": {"type": "string", "minLength": 1},
        "input_player_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
        "observation_access": {"const": false},
        "state_feedback_access": {"const": false},
        "state_reset_allowed": {"const": false},
        "contact_policy_id": {"type": ["string", "null"], "minLength": 1},
        "contact_policy_version": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
        "contact_policy_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "external_loads_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "integrityHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_identity_sha256", "state_schema_sha256", "capability_declarations_sha256", "input_channel_schema_sha256", "time_grid_sha256", "initial_state_sha256", "applied_input_sha256", "execution_policy_sha256"],
      "properties": {
        "model_identity_sha256": {"$ref": "#/$defs/sha256"},
        "state_schema_sha256": {"$ref": "#/$defs/sha256"},
        "capability_declarations_sha256": {"$ref": "#/$defs/sha256"},
        "input_channel_schema_sha256": {"$ref": "#/$defs/sha256"},
        "time_grid_sha256": {"$ref": "#/$defs/sha256"},
        "initial_state_sha256": {"$ref": "#/$defs/sha256"},
        "applied_input_sha256": {"$ref": "#/$defs/sha256"},
        "execution_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
