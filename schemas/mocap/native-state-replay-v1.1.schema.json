{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.d-sorganization.org/mocap/native-state-replay-v1.1.schema.json",
  "title": "Native State Replay Envelope v1.1",
  "description": "Opaque complete-native-restart metadata and saved input identity. Structural validity does not qualify decoded native state or physics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "schema_version",
    "model",
    "artifact",
    "capabilities",
    "input_history",
    "policy",
    "integrity"
  ],
  "properties": {
    "experiment_id": {"$ref": "#/$defs/text"},
    "schema_version": {"const": "native-state-replay/1.1.0"},
    "model": {"$ref": "#/$defs/model"},
    "artifact": {"$ref": "#/$defs/artifact"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "experiment-replay-v1.schema.json#/$defs/capability"}
    },
    "input_history": {
      "$ref": "experiment-replay-v1.schema.json#/$defs/inputHistory"
    },
    "policy": {"$ref": "experiment-replay-v1.schema.json#/$defs/executionPolicy"},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "variant_id",
        "model_version",
        "ordered_input_channel_ids"
      ],
      "properties": {
        "model_id": {"$ref": "#/$defs/text"},
        "variant_id": {"$ref": "#/$defs/text"},
        "model_version": {"$ref": "#/$defs/semver"},
        "ordered_input_channel_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "identity",
        "clock",
        "execution",
        "payload_sha256",
        "byte_size",
        "role"
      ],
      "properties": {
        "encoding": {"$ref": "#/$defs/encoding"},
        "identity": {"$ref": "#/$defs/identity"},
        "clock": {"$ref": "#/$defs/clock"},
        "execution": {"$ref": "#/$defs/execution"},
        "payload_sha256": {
          "$ref": "experiment-replay-v1.schema.json#/$defs/sha256"
        },
        "byte_size": {"type": "integer", "minimum": 1},
        "role": {"const": "complete_native_restart"}
      }
    },
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_id", "format_version", "native_class"],
      "properties": {
        "format_id": {"$ref": "#/$defs/text"},
        "format_version": {"$ref": "#/$defs/semver"},
        "native_class": {"$ref": "#/$defs/text"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_id",
        "runtime_id",
        "provider_sha256",
        "source_model_sha256",
        "loaded_model_sha256"
      ],
      "properties": {
        "engine_id": {"$ref": "#/$defs/text"},
        "runtime_id": {"$ref": "#/$defs/text"},
        "provider_sha256": {
          "$ref": "experiment-replay-v1.schema.json#/$defs/sha256"
        },
        "source_model_sha256": {
          "$ref": "experiment-replay-v1.schema.json#/$defs/sha256"
        },
        "loaded_model_sha256": {
          "$ref": "experiment-replay-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_time_seconds",
        "snapshot_time_seconds",
        "clock_id"
      ],
      "properties": {
        "start_time_seconds": {"type": "number"},
        "snapshot_time_seconds": {"type": "number"},
        "clock_id": {"$ref": "#/$defs/text"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solver_id",
        "solver_version",
        "policy_id",
        "policy_version",
        "effective_configuration_sha256",
        "compatibility_sha256"
      ],
      "properties": {
        "solver_id": {"$ref": "#/$defs/text"},
        "solver_version": {"$ref": "#/$defs/semver"},
        "policy_id": {"$ref": "#/$defs/text"},
        "policy_version": {"$ref": "#/$defs/semver"},
        "effective_configuration_sha256": {
          "$ref": "experiment-replay-v1.schema.json#/$defs/sha256"
        },
        "compatibility_sha256": {
          "$ref": "experiment-replay-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "envelope_sha256"],
      "properties": {
        "components": {
          "$ref": "experiment-replay-v1.schema.json#/$defs/integrityHashes"
        },
        "envelope_sha256": {
          "$ref": "experiment-replay-v1.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
