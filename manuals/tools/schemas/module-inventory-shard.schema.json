{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.d-sorganization.org/tools/module-inventory-shard/1.1.0.json",
  "title": "Tools Module Inventory Shard (one top-level package)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority",
    "entries",
    "package",
    "schema_version"
  ],
  "properties": {
    "authority": {
      "const": "D-sorganization/Tools"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.d-sorganization.org/tools/module-inventory/1.0.0.json#/$defs/entry"
      }
    },
    "schema_version": {
      "const": "tools-module-inventory-shard/1.1.0"
    },
    "package": {
      "type": "string",
      "minLength": 1
    }
  }
}
