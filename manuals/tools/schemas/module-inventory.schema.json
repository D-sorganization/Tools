{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.d-sorganization.org/tools/module-inventory/1.0.0.json",
  "title": "Tools Module Inventory (thin index)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority",
    "blockers",
    "hash_contract",
    "producer",
    "release_status",
    "schema_version",
    "scope",
    "shards"
  ],
  "properties": {
    "authority": {
      "const": "D-sorganization/Tools"
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/shardDescriptor"
      }
    },
    "hash_contract": {
      "$ref": "#/$defs/hashContract"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "release_status": {
      "const": "blocked-pathways-required"
    },
    "schema_version": {
      "const": "tools-module-inventory/1.0.0"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    }
  },
  "$defs": {
    "authorityStatus": {
      "enum": [
        "blocked",
        "not-applicable",
        "provisional"
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "resolution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "classification": {
      "enum": [
        "calculation",
        "non-calculation"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/count"
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_status",
        "bytes_lf",
        "classification",
        "classification_basis",
        "content_sha256_lf",
        "family",
        "id",
        "language",
        "maintainer",
        "path",
        "purpose",
        "review_status",
        "risk_tags",
        "states",
        "traceability"
      ],
      "properties": {
        "authority_status": {
          "$ref": "#/$defs/authorityStatus"
        },
        "bytes_lf": {
          "$ref": "#/$defs/count"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "classification_basis": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256_lf": {
          "$ref": "#/$defs/sha256"
        },
        "family": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "id": {
          "type": "string",
          "pattern": "^TOOLS-MODULE-[A-Z0-9-]+$"
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "maintainer": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_status": {
          "$ref": "#/$defs/reviewStatus"
        },
        "risk_tags": {
          "$ref": "#/$defs/stringArray"
        },
        "states": {
          "$ref": "#/$defs/states"
        },
        "traceability": {
          "$ref": "#/$defs/traceability"
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "id",
        "maintainer",
        "rationale"
      ],
      "properties": {
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "maintainer": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hashContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "line_endings",
        "tree_encoding"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "line_endings": {
          "const": "CRLF-and-CR-normalized-to-LF"
        },
        "tree_encoding": {
          "const": "path-colon-content_sha256_lf-newline"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator_path",
        "schema_path"
      ],
      "properties": {
        "generator_path": {
          "const": "scripts/build_tools_module_inventory.py"
        },
        "schema_path": {
          "const": "manuals/tools/schemas/module-inventory.schema.json"
        }
      }
    },
    "publicSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "signature"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reviewStatus": {
      "enum": [
        "blocked",
        "inventory-baseline",
        "review-required"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery",
        "exclusions",
        "roots",
        "suffixes"
      ],
      "properties": {
        "discovery": {
          "const": "tracked-implementation-and-governed-configuration-modules"
        },
        "exclusions": {
          "$ref": "#/$defs/stringArray"
        },
        "roots": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "suffixes": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "shardDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_sha256_lf",
        "entry_count",
        "package",
        "path"
      ],
      "properties": {
        "content_sha256_lf": {
          "$ref": "#/$defs/sha256"
        },
        "entry_count": {
          "type": "integer",
          "minimum": 1
        },
        "package": {
          "type": "string",
          "minLength": 1,
          "description": "Top-level package key: src/<pkg>, src/shared/python/<pkg>, rust_core/<crate>, or a root directory."
        },
        "path": {
          "type": "string",
          "pattern": "^manuals/tools/manifests/module-inventory/entries-[a-z0-9-]+\\.json$"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "blocked",
        "mapped",
        "not-applicable",
        "unavailable",
        "unmapped-pending-TOOLS-D4",
        "unmapped-pending-TOOLS-D7"
      ]
    },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "adrs",
        "chapters",
        "citations",
        "equation_pathway",
        "publication",
        "public_surfaces",
        "routes",
        "tests",
        "units",
        "validation"
      ],
      "properties": {
        "artifacts": {
          "$ref": "#/$defs/state"
        },
        "adrs": {
          "$ref": "#/$defs/state"
        },
        "chapters": {
          "$ref": "#/$defs/state"
        },
        "citations": {
          "$ref": "#/$defs/state"
        },
        "equation_pathway": {
          "$ref": "#/$defs/state"
        },
        "publication": {
          "$ref": "#/$defs/state"
        },
        "public_surfaces": {
          "$ref": "#/$defs/state"
        },
        "routes": {
          "$ref": "#/$defs/state"
        },
        "tests": {
          "$ref": "#/$defs/state"
        },
        "units": {
          "$ref": "#/$defs/state"
        },
        "validation": {
          "$ref": "#/$defs/state"
        }
      }
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_status_counts",
        "blocked_count",
        "calculation_count",
        "classification_counts",
        "family_counts",
        "module_count",
        "non_calculation_count",
        "provisional_count",
        "review_status_counts"
      ],
      "properties": {
        "authority_status_counts": {
          "$ref": "#/$defs/counts"
        },
        "blocked_count": {
          "$ref": "#/$defs/count"
        },
        "calculation_count": {
          "$ref": "#/$defs/count"
        },
        "classification_counts": {
          "$ref": "#/$defs/counts"
        },
        "family_counts": {
          "$ref": "#/$defs/counts"
        },
        "module_count": {
          "type": "integer",
          "minimum": 1
        },
        "non_calculation_count": {
          "$ref": "#/$defs/count"
        },
        "provisional_count": {
          "$ref": "#/$defs/count"
        },
        "review_status_counts": {
          "$ref": "#/$defs/counts"
        }
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adr_paths",
        "artifact_sha256",
        "chapter_paths",
        "citation_refs",
        "equation_refs",
        "public_surfaces",
        "public_routes",
        "test_paths",
        "unit_mentions",
        "validation_paths"
      ],
      "properties": {
        "adr_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "artifact_sha256": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "chapter_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "citation_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "equation_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "public_surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicSurface"
          }
        },
        "public_routes": {
          "$ref": "#/$defs/stringArray"
        },
        "test_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "unit_mentions": {
          "$ref": "#/$defs/stringArray"
        },
        "validation_paths": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  },
  "description": "Thin, package-sharded index (Tools #4818/#4915): envelope metadata plus one descriptor per top-level-package shard. families, summary and source_tree_sha256 are derived from the shards at load time (scripts/tools_module_inventory_storage.py) and are not stored, so PRs touching different packages never conflict on this file."
}
