          "family_id": "tools.derivation.dplane-geometry",
          "calculation_id": "TOOLS-DPLANE-GEOMETRY",
          "assumptions": [
            "Finite vectors inhabit Euclidean three-space in one declared right-handed orthonormal target frame.",
            "The delivered face normal and instantaneous travel direction define geometry only, not collision or flight response."
          ],
          "dimensions": [
            "Angles are dimensionless radians internally and are returned in degrees.",
            "Direction, dot-product, and cross-product terms are dimensionless after velocity normalization."
          ],
          "domains": [
            "Face, target, and up vector norms exceed 1e-12 and target is orthogonal to up within 1e-10.",
            "Spin loft lies on the principal interval from zero through 180 degrees; signed headings wrap to [-180, 180)."
          ],
          "numerical_method": "Validate finite three-vectors, normalize with the declared epsilon, clip inverse-cosine arguments, use atan2 for signed orientation, and return typed singular states without substitution.",
          "uncertainty_and_limitations": [
            "Input orientation, event interpolation, frame registration, and datum selection are not assigned covariance by this implementation.",
