# Environment Variables Example
# Copy this file to .env and fill in the values
#
# SECURITY NOTE: Never commit real credentials. Use OWASP-safe test values:
# - API keys: Use prefix OWASP-TEST-API-KEY-
# - Auth tokens: Use prefix OWASP-TEST-TOKEN-
# - Passwords: Use prefix OWASP-TEST-PASSWORD-
# See docs/SECRETS_MANAGEMENT.md for complete guidelines.

# Flask Application
FLASK_APP=web_applications.calculator.webapp
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=OWASP-TEST-SECRET-KEY-SAFE-FOR-TESTING-ONLY

# API Keys (if applicable)
# OPENAI_API_KEY=OWASP-TEST-API-KEY-OPENAI-EXAMPLE
# GEMINI_API_KEY=OWASP-TEST-API-KEY-GEMINI-EXAMPLE

# Database (if applicable)
# DATABASE_URL=sqlite:///db.sqlite3

# Authentication tokens
# AUTH_TOKEN=OWASP-TEST-TOKEN-SAFE-FOR-TESTING-ONLY

# GitHub API (for rate-limit testing)
# GITHUB_TOKEN=OWASP-TEST-TOKEN-GITHUB-EXAMPLE
