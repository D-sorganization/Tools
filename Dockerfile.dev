# Dockerfile.dev — Development image for Tools shared library
# Build: docker build -f Dockerfile.dev -t tools:dev .
# Run: docker run -it -v $(pwd):/workspace tools:dev bash
#
# Features:
# - Python 3.11+ with all dev dependencies
# - Ruff, pytest, mypy pre-installed for linting/testing
# - Live code editing via volume mounts
# - Hot-reload support for FastAPI via uvicorn

FROM python:3.11-slim

LABEL maintainer="UpstreamDrift Team"
LABEL description="Development image for Tools shared library"
LABEL version="1.0.0"

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    WORKSPACE=/workspace

# Install system dependencies
# Keep to a minimal set needed for dev tools and scientific computing
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR ${WORKSPACE}

# Copy dependency specifications
COPY pyproject.toml requirements.txt requirements-lock.txt ./

# Install Python dependencies in single layer to reduce image size
# Install base + dev deps for testing and linting
RUN pip install --upgrade pip setuptools wheel && \
    pip install -r requirements-lock.txt && \
    pip install -e ".[dev,all]"

# Create non-root user for security (optional but recommended)
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser ${WORKSPACE}

USER appuser

# Default command: bash for interactive development
CMD ["/bin/bash"]
