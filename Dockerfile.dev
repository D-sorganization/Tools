# Dockerfile.dev — Development Image for Tools
# Purpose: Live development environment with all dependencies and dev tools
# Usage: docker build -f Dockerfile.dev -t tools:dev .
# Runtime: docker run -it -v $(pwd):/workspace tools:dev

FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# Set working directory
WORKDIR /workspace

# Install system dependencies (required for some Python packages)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    ca-certificates \
    libffi-dev \
    libssl-dev \
    libjpeg-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files
COPY requirements.txt requirements-lock.txt* pyproject.toml setup.py ./

# Install Python dependencies
RUN pip install --upgrade pip setuptools wheel && \
    pip install -e ".[all,dev]"

# Copy source code
COPY . .

# Install package in development mode (editable)
RUN pip install -e .

# Create non-root user for development (optional but recommended)
RUN useradd -m -s /bin/bash devuser && \
    chown -R devuser:devuser /workspace

# Switch to non-root user
USER devuser

# Default command: Python interactive shell
CMD ["python3"]
